[Unit]
Description=pocknix: check wifi reaches the gateway after boot, bounce it if not
# A cold boot sometimes comes up associated but with no route past the LAN (NetworkManager
# "limited"); Steam then says it is offline. Same heal as after resume, run once at boot.
After=NetworkManager.service network.target
Wants=NetworkManager.service

[Service]
# Type=exec, NOT oneshot: systemd orders a target After= everything it Wants, so a oneshot
# here held multi-user.target (and every unit ordered After=multi-user.target: power mode,
# game affinity, fan control, the diag dump) until the whole heal ladder had run - about
# 2.5 min on any boot without a network. The heal is a background check; the boot must not
# wait for it.
Type=exec
Environment=POCKNIX_WIFI_HEAL_WAIT=45
ExecStart=/usr/lib/pocknix/pocknix-wifi-heal boot

[Install]
WantedBy=multi-user.target
