# pocknix-bsp-common — the device-NEUTRAL board-support mechanics shared by every
# pocknix device: the sleep.d dispatcher + suspend hooks, the handheld power-key
# policy, and the session udev rules. Device-specific quirks (input maps, audio
# UCM, SoC suspend/cpuidle tweaks, device.conf) live in each device's BSP under
# devices/<name>/packages/pocknix-bsp-<name>, which depends on this package.
pkgname=pocknix-bsp-common
pkgver=0.1.0
pkgrel=12
pkgdesc="pocknix shared board support: sleep.d dispatcher, suspend hooks, power-key policy, session udev rules"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=()
source=('pocknix-sleep' 'sdam-debug-pre' 'sdam-debug-post'
        'wifi-sleep-pre' 'wifi-sleep-post'
        'pocknix-telemetryd' 'pocknix-telemetry.service'
        'pocknix-power-mode' 'pocknix-power-mode.service'
        'pocknix-wifi-heal'
        'leds-sleep-pre' 'leds-sleep-post'
        '20-pocknix-powerkey.conf' 'no-freeze-user-sessions.conf'
        '90-pocknix-backlight.rules' '60-pocknix-controllers.rules')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # systemd system-sleep hook that dispatches our sleep.d/{pre,post} scripts
  install -Dm755 "${srcdir}/pocknix-sleep" \
    "${pkgdir}/usr/lib/systemd/system-sleep/pocknix-sleep"

  # suspend/resume hooks (run by the hook above, in name order)
  # 000-wifi: radio off before sleep — a wedged WCN7860 tx queue makes ath12k's
  # suspend time out and ABORTS the whole system suspend (looks like instant wake),
  # and the hung fw kills scanning until reboot. Drain + quiesce first; restore on
  # resume. Runs FIRST so the fw parks while the other hooks do their work.
  install -Dm755 "${srcdir}/wifi-sleep-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/000-wifi"
  install -Dm755 "${srcdir}/wifi-sleep-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/000-wifi"
  # (RETIRED 2026-08-12: the 001-inputplumber stop/start hooks. They existed only
  # because the usbip `deck` target's vhci_hcd vetoed suspend; the deck-uhid target
  # has no veto, InputPlumber rides through suspend alive, and THAT unbroken
  # Steam<->pad connection is what makes suspend-mid-game seamless. Do not revive.)
  # 004-leds: extinguish the stick RGB rings across suspend (save/restore), so 24
  # LEDs don't sip the sleep budget. Runs late (004) — after the input teardown.
  install -Dm755 "${srcdir}/leds-sleep-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/004-leds"
  install -Dm755 "${srcdir}/leds-sleep-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/004-leds"
  # 003-sdam-debug: Qualcomm PMIC SDAM suspend breadcrumb (fail-soft on non-SPMI
  # hardware — the dd just logs to kmsg and moves on).
  install -Dm755 "${srcdir}/sdam-debug-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/003-sdam-debug"
  install -Dm755 "${srcdir}/sdam-debug-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/003-sdam-debug"

  # Telemetry: 60s battery/thermal/clock sampler -> /var/lib/pocknix/telemetry.csv.
  # Data-first power work: sleep-drain %/hr, per-scenario watts, fan/thermal curves.
  install -Dm755 "${srcdir}/pocknix-telemetryd" \
    "${pkgdir}/usr/lib/pocknix/pocknix-telemetryd"
  install -Dm644 "${srcdir}/pocknix-telemetry.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-telemetry.service"

  # Power profiles: eco/balanced/performance cpu+gpu caps, persisted + boot-applied.
  install -Dm755 "${srcdir}/pocknix-power-mode" \
    "${pkgdir}/usr/local/bin/pocknix-power-mode"
  install -Dm644 "${srcdir}/pocknix-power-mode.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-power-mode.service"

  # Post-resume Wi-Fi self-heal (called async by the 000-wifi post hook).
  install -Dm755 "${srcdir}/pocknix-wifi-heal" \
    "${pkgdir}/usr/lib/pocknix/pocknix-wifi-heal"

  # Power button: wake-and-stay (HandlePowerKey=ignore) instead of systemd's default
  # poweroff (which made a wake-press shut the device down). Sleep via the Steam menu.
  # Handheld policy, not a device quirk — pairs with pocknix-powerd (overlay).
  install -Dm644 "${srcdir}/20-pocknix-powerkey.conf" \
    "${pkgdir}/usr/lib/systemd/logind.conf.d/20-pocknix-powerkey.conf"

  # Suspend: keep user sessions unfrozen (see the .conf for why).
  install -Dm644 "${srcdir}/no-freeze-user-sessions.conf" \
    "${pkgdir}/usr/lib/systemd/system/systemd-suspend.service.d/no-freeze-user-sessions.conf"

  # udev rule: let the 'video' group (non-root session user) write panel brightness
  # so Steam's brightness slider works as the deck user. Matches any backlight.
  install -Dm644 "${srcdir}/90-pocknix-backlight.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/90-pocknix-backlight.rules"
  # Controller uaccess for the non-root deck session (ALARM has no game-devices-udev).
  # Critical for the InputPlumber 'deck' target (Valve 28de) hidraw that Steam Input reads.
  install -Dm644 "${srcdir}/60-pocknix-controllers.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/60-pocknix-controllers.rules"
}
