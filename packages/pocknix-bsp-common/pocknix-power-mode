#!/bin/sh
# pocknix-power-mode — eco|balanced|performance CPU+GPU caps (+ status).
#
# Discovers cpufreq policies and the GPU devfreq node, caps each at a profile
# fraction of hardware max (kernel clamps CPU writes to valid steps; the GPU cap
# picks the nearest available step <= target). Mode persists in
# /var/lib/pocknix/power-mode; pocknix-power-mode.service re-applies at boot.
# Born from telemetry: an uncapped A830 + shader storm = 20W draw, 95C, and a
# net-discharging "charging" device. Eco exists so the fan and battery can win.
#   eco:         CPU 60% / GPU ~55%   (fan curve stays user-selected; pair with quiet)
#   balanced:    CPU 80% / GPU ~82%
#   performance: uncapped
MODE_FILE=/var/lib/pocknix/power-mode
MODE="${1:-$(cat "$MODE_FILE" 2>/dev/null || echo performance)}"
case "$MODE" in
  eco)         CPU_PCT=60; GPU_PCT=55 ;;
  balanced)    CPU_PCT=80; GPU_PCT=82 ;;
  performance) CPU_PCT=100; GPU_PCT=100 ;;
  status)
    for p in /sys/devices/system/cpu/cpufreq/policy*; do
      echo "cpu$(cat $p/affected_cpus | tr -d ' '): $(cat $p/scaling_max_freq)/$(cat $p/cpuinfo_max_freq) kHz"
    done
    G=$(ls -d /sys/class/devfreq/*.gpu 2>/dev/null | head -1)
    [ -n "$G" ] && echo "gpu: $(cat $G/max_freq)/$(cat $G/available_frequencies | tr ' ' '\n' | sort -n | tail -1) Hz"
    echo "mode: $(cat "$MODE_FILE" 2>/dev/null || echo performance)"
    exit 0 ;;
  *) echo "usage: $0 {eco|balanced|performance|status}"; exit 2 ;;
esac
for p in /sys/devices/system/cpu/cpufreq/policy*; do
  max=$(cat "$p/cpuinfo_max_freq")
  echo $((max * CPU_PCT / 100)) > "$p/scaling_max_freq" 2>/dev/null
done
G=$(ls -d /sys/class/devfreq/*.gpu 2>/dev/null | head -1)
if [ -n "$G" ]; then
  gmax=$(tr ' ' '\n' < "$G/available_frequencies" | sort -n | tail -1)
  target=$((gmax * GPU_PCT / 100))
  best=$(tr ' ' '\n' < "$G/available_frequencies" | sort -n | awk -v t="$target" '$1<=t{b=$1} END{print b}')
  [ -n "$best" ] && echo "$best" > "$G/max_freq" 2>/dev/null
fi
mkdir -p "$(dirname "$MODE_FILE")"; echo "$MODE" > "$MODE_FILE"
echo "power mode: $MODE (cpu ${CPU_PCT}%, gpu ${GPU_PCT}%)"
