#!/bin/sh
# Resume side: reload the gamepad stack only if we unloaded it. Runs BEFORE
# 001-inputplumber starts InputPlumber (000b < 001), so the device exists when
# IP enumerates — and IP's hotplug covers any race regardless.
FLAG=/run/pocknix-rsinput-resume
if [ -e "${FLAG}" ]; then
  rm -f "${FLAG}"
  modprobe qcom_hv_haptics 2>/dev/null || true
  modprobe rsinput 2>/dev/null || true
fi
exit 0
