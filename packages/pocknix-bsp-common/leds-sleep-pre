#!/bin/sh
# Save + extinguish the stick RGB rings before suspend. 24 LEDs at full tilt sip
# real microamps over a multi-hour sleep; the measured 0.7%/hr standby number
# deserves protecting. Saves every channel's brightness to /run, zeroes them;
# the post hook restores. No-op if the LEDs aren't present (older kernel).
SAVE=/run/pocknix-leds-resume
: > "${SAVE}"
for f in /sys/class/leds/r:* /sys/class/leds/l:*; do
  [ -w "${f}/brightness" ] || continue
  echo "${f} $(cat "${f}/brightness" 2>/dev/null || echo 0)" >> "${SAVE}"
  echo 0 > "${f}/brightness" 2>/dev/null || true
done
exit 0
