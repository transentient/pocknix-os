#!/bin/sh
# Unload the gamepad module (and its haptics dependency) before suspend.
# HARDWARE-BISECTED (Odin 3, 2026-08-08 ledger + two controlled module tests):
# with rsinput loaded, resume wedges hard on most cycles (journal ends at
# "PM: suspend entry") — the 0508 MCU-reinit-on-resume path is the prime
# suspect; qcom_hv_haptics alone suspends clean (3/3). Until the kernel ships
# without/with-fixed 0508, keep suspend safe by removing the module entirely:
# runs AFTER 001-inputplumber stopped InputPlumber (which held the device).
FLAG=/run/pocknix-rsinput-resume
if lsmod | grep -q '^rsinput'; then
  : > "${FLAG}"
  modprobe -r rsinput 2>/dev/null || true
fi
exit 0
