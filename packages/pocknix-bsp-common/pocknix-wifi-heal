#!/bin/sh
# pocknix-wifi-heal — post-resume / post-boot Wi-Fi verification with escalating recovery.
# Ported idea from batocera.pocket's resume toggle+resilience (credit lukemotion);
# our escalation adds a PCIe remove/rescan = full ath1xk firmware reload, no reboot.
# Launched as a transient unit by the 000-wifi resume hook, by the NM dispatcher hook on
# LIMITED, and once at boot (pocknix-wifi-heal-boot.service); logs to
# /var/lib/pocknix/wifi-heal.log. The usual failure (09-03) is a post-resume roam that
# asserts the WCN7860 firmware: the kernel recovers the chip ("pdev 0 successfully
# recovered") but NM is left with a dead activation, so the gentle fix is simply to
# re-activate the profile. Escalate only if that doesn't take.
LOG=/var/lib/pocknix/wifi-heal.log
say() { echo "$(date -Iseconds) $*" >> "$LOG"; }
wifi_dev() {  # the wifi netdev by type, whatever it is called (wlan0 at boot, wlan1 after a firmware reload)
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'
}
wifi_state() {  # NM's state for it: connected / connecting / disconnected / unavailable / unmanaged / "" (no device)
  nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: '$2=="wifi"{print $3; exit}'
}
gateway() {
  ip -4 route show default 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "via") {print $(i + 1); exit}}'
}
healthy() {
  # Healthy = a default route whose gateway answers us, or NetworkManager seeing the
  # internet. The things this heal can fix are on our side of the router: a dead
  # activation after a firmware recovery, a stuck first association, the router gone
  # silent to this one client (2026-10-08: "limited", ARP fine, gateway dropped our
  # IP traffic, `nmcli connection up` fixed it). The internet being down behind a
  # gateway that answers is NOT our problem, and until 2026-10-11 it was treated as
  # one: NM's "full" check (an HTTP GET to ping.archlinux.org) was the only test, so a
  # WAN outage or a slow check host walked every boot and every wake down the whole
  # ladder, ending in a PCIe reset of a working wifi chip.
  gw=$(gateway)
  [ -n "$gw" ] || return 1
  ping -c 1 -W 1 "$gw" >/dev/null 2>&1 && return 0
  [ "$(nmcli networking connectivity check 2>/dev/null)" = "full" ]
}
wait_healthy() {
  i=0
  while [ "$i" -lt "$1" ]; do healthy && return 0; sleep 2; i=$((i + 1)); done
  return 1
}
profile() {  # most recently used wifi profile
  nmcli -t -f NAME,TYPE connection show --order -timestamp 2>/dev/null \
    | awk -F: '$2=="802-11-wireless"{print $1; exit}'
}
# Patience first: after a long sleep the AP may refuse the first association and iwd retries on
# its own (RP5 2026-10-03: "PREV_AUTH_NOT_VALID", then connected). Escalating into a PCIe reset
# inside a minute turned that into a day of dead wifi (the netdev came back as wlan1 and the
# profile was pinned to wlan0). So: ~1 min of waiting, then the profile, then the radio, and the
# PCIe reset only when the wifi device itself is gone or unusable (the driver or firmware is
# wedged) - never on a device that is alive but merely not connected: no profile, no AP in
# range, an AP that refuses us or a router that ignores us are not cured by reloading firmware,
# and the reload itself is the risky step (device renamed, firmware fails to come back).
wait_healthy "${POCKNIX_WIFI_HEAL_WAIT:-30}" && { say "ok (no action)"; exit 0; }
PROF=$(profile)
if [ -z "$PROF" ]; then
  say "unhealthy (${1:-resume}) but no wifi profile is configured (wifi dev: $(wifi_dev), state: $(wifi_state)): nothing to heal"
  exit 0
fi
say "unhealthy (${1:-resume}) -> nmcli connection up '$PROF' (wifi dev: $(wifi_dev), state: $(wifi_state), gateway: $(gateway))"
nmcli connection up "$PROF" >/dev/null 2>&1 || true
wait_healthy 15 && { say "recovered via connection up"; exit 0; }
say "still unhealthy -> radio cycle"
nmcli radio wifi off 2>/dev/null; sleep 2; nmcli radio wifi on 2>/dev/null
wait_healthy 15 && { say "recovered via radio cycle"; exit 0; }
DEV=$(wifi_dev); STATE=$(wifi_state)
case "$STATE" in
  ""|unavailable) ;;  # no wifi netdev, or NM cannot use it with the radio on: driver/firmware trouble
  *)
    say "still unhealthy, but the wifi device is alive (${DEV}: ${STATE}, gateway: $(gateway)): leaving the chip alone - the AP/router side is the problem; re-activate the profile or check the router"
    exit 0 ;;
esac
say "still unhealthy and the wifi device is ${STATE:-missing} -> PCIe reset (full fw reload)"
PCI=""
[ -n "$DEV" ] && PCI=$(basename "$(readlink -f "/sys/class/net/${DEV}/device" 2>/dev/null)" 2>/dev/null)
if [ -z "$PCI" ] || [ ! -e "/sys/bus/pci/devices/${PCI}/remove" ]; then
  # the netdev is gone: find the chip by its driver (ath11k_pci on sm8250, ath12k_pci on sm8750)
  for d in /sys/bus/pci/drivers/ath1*k_pci/0000:*; do
    [ -e "$d/remove" ] && { PCI=$(basename "$d"); break; }
  done
fi
if [ -n "$PCI" ] && [ -e "/sys/bus/pci/devices/${PCI}/remove" ]; then
  nmcli radio wifi off 2>/dev/null; sleep 1
  echo 1 > "/sys/bus/pci/devices/${PCI}/remove"; sleep 2
  echo 1 > /sys/bus/pci/rescan; sleep 4
  nmcli radio wifi on 2>/dev/null
  sleep 4
  nmcli connection up "$PROF" >/dev/null 2>&1 || true
  wait_healthy 15 && { say "recovered via PCIe reset (wifi dev now: $(wifi_dev))"; exit 0; }
else
  say "no PCI wifi device found to reset (netdev: ${DEV:-none})"
fi
say "UNRECOVERED - manual toggle or reboot needed (wifi dev: $(wifi_dev), state: $(wifi_state))"
exit 0
