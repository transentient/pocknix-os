# linux-pocknix-sm8250 — the SM8250 kernel as a pacman package. Per-SoC, not
# per-device: /boot/dtbs carries the boards this image serves (_dtb_globs — the Retroid
# Pocket 5 / Flip 2 (+ their Visionox-panel variants) / Mini / Mini V2), packaged from
# 'make kernel' output: build-packages.sh copies build/kernel/sm8250/out into the
# package's build dir as ./staged; package() lays it out as /boot/Image + /boot/dtbs +
# /usr/lib/modules/<ver> + the mkbootimg tool.
#
# Boot contract (qcom-abl, settled 2026-09-28): the ROCKNIX ABL loads /flash/KERNEL as an
# ANDROID! boot image = gzip(Image) with the board dtbs appended + a GPU-firmware ramdisk +
# the cmdline (from pocknix-bsp-sm8250's /usr/lib/pocknix/kernel-cmdline). The alpm hook
# (90-linux-pocknix.hook -> pocknix-build-bootimg) rebuilds it after a kernel transaction.
pkgname=linux-pocknix-sm8250
pkgver=7.1.2
pkgrel=32   # 32 (2026-10-15, EXPERIMENT): 31 minus ROCKNIX 0017 (DRM audio helper hw_params = prepare), so the DP audio engine is enabled in the codec PREPARE, after the DSP DEVICE_START, to test whether the vendor order ends the held-START race (trace fs1/fs4: START stuck ~40 % of the time when the engine is already on, released when the engine goes off) / 31 (2026-10-15, untested): 0727 q6asm-dai front ends S16_LE only (24-bit FE measured 9 dB low), on top of 30 (0100 staged out) / 30 (2026-10-15, MEASUREMENT BUILD, untested): ROCKNIX 0100-revert-force-16bit-audio moved to patches-staged, back ends forced to S16_LE as upstream sm8250.c does; to measure the 24-bit sample-path loss (docs/audio-architecture-rp5-2026-10-15.md 3.1) / 29 (2026-10-15, TESTED 11:13 fresh undocked boot [off,HiFi,HDMI no] + redock HDMI tone -44.8 dBFS: 0726 q6afe-dai DisplayPort/HDMI prepare accepted with no sink via hdmi-codec sink presence, HDMI profile must survive an undocked boot) / 28 (2026-10-14, TESTED 23:13: docked sleep/wake picture + PD + 9 V contract all back, link-off test clean, Rp stays 3.0 A): + 0725 (ours): msm_dp puts an attached sink in D3 (DP_SET_POWER) before a DRM-initiated off and back to D0 before the re-enable's forced training (vendor dp_display_unprepare parity; upstream only for sink_count == 0), and services the sink's IRQ_HPD when it arrives as a USB-C DisplayPort Attention with HPD high (EV_IRQ_HPD_INT: status read + link maintenance on request) instead of ignoring it. Evidence (kernel 27 rig, 10-14 evening): PD stays alive across a docked sleep (0724 works) but the dock's AUX is dead at resume; holding the DP link down 3 min WITHOUT sleeping parks the dock the same way (IRQ_HPD every 10 s, HPD bounce, EDID read fails), and an alt-mode Exit+Enter revives it. + CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y (/dev/drm_dp_aux0: read the sink's DPCD from userland).   # 27 (2026-10-14, UNTESTED): + 0724 (ours): PMIC Type-C/PD state re-synchronised after system suspend. ROOT CAUSE of the docked sleep -> dark DisplayPort + dead PD (10-14 overnight + rig cycle1): spmi-pmic-arb masks every non-wake PMIC irq for suspend and wipes the LATCHED status on unmask, so the dock's second DP Attention (sent after the irqs were masked) stayed in the PD PHY rx buffer with the token software-owned: every PD tx -EBUSY "RX message pending", every later rx dropped, until replug. complete() delivers the buffered message and re-reads CC/VBUS; resume_noirq logs the latched bits. Also: a corrupt rx frame no longer hands tcpm an unread message or wedges the buffer. Kernel otherwise = 26.   # 26 (2026-10-12): RP5 dts: GPIO-driven DisplayPort AUX/SBU switch (gpio-sbu-mux: enable tlmm 9 active low, select tlmm 8 = reversed plug) on the connector's SBU port, carrying the mode-switch; found in the live Android device tree (qcom,dp-gpio-aux-switch on the DP node). A reversed plug had no DP because the AUX pair was never switched (0723 alone could not help). CONFIG_TYPEC_MUX_GPIO_SBU built in.   # 25 (2026-10-12): 0723: qmp-combo v4 writes QSERDES_DP_PHY_MODE (0x4c reversed / 0x5c normal) in dp_aux_init, before the first AUX read; upstream only wrote it at phy_configure (link training), so a reversed USB-C plug had dead AUX = no DP (24 proved SS + ethernet reversed, DP still off). 24 (orientation-switch only) boots undocked + docked.   # 24 (2026-10-12): as 23 but the PHY carries orientation-switch ONLY (sm8150-hdk pattern); 23 (orientation-switch + mode-switch) did not come back on wifi/ethernet after its docked reboot (cause unknown at build time).   # 23 (2026-10-12): RP5 dts: the NB7VPQ904M redriver node (typec-mux@1c on i2c15, from ROCKNIX) is a PHANTOM (nothing ACKs on the bus; the vendor dtbo has it disabled); it swallowed the plug orientation, so a reversed USB-C plug had power but no SuperSpeed and no DisplayPort on both docks. Removed; the connector's SS endpoint goes straight to usb_1_qmpphy, which now carries orientation-switch + mode-switch.   # 22 (2026-10-12): 0722 v5: input allowance CONTINUOUS (0x1344) + continuous AICL threshold = contract - 1 V; kernel 21's 9 V PDO made the chip flag USBIN_OV and suspend the input (blackbox usbint=18 pp=d8, battery discharging on the dock, 15:42-15:50). Vendor recipe (smblib_set_usb_pd_allowed_voltage).   # 21 (2026-10-12): RP5 dts sink-pdos add 9 V / 2 A (op-sink 18 W): docks offer a tiny 5 V profile (Elecom DST-090BP1SV 5 V/0.5 A vs 9 V/1.34 A; the 65 W charger 9 V/3 A); the chip allows 9-12 V (0x1360 = 0x07). Contract honoured by 0722 v4 at whatever the source gives.   # 20 (2026-10-12): 0722 v4: a PD contract is ALWAYS applied in software mode. v3 put contracts of <= 500 mA into hardware auto mode with APSD off and the chip used its stale APSD result: on the Elecom hub (5 V / 0.5 A contract) the RP5 sat at ICL_MAX 3 A and drew 2 A (blackbox iclmax=3c icl=28, 14:53). v3 (19) was otherwise right: the override bit is gone, the log names the source.   # 19 (2026-10-12, UNTESTED): 0722 v3 - the input-limit mode bits as the vendor driver sets them (USBIN_MODE_CHG + ICL_OVERRIDE_AFTER_APSD, CMD_ICL_OVERRIDE clear, BC1.2/APSD off during a PD contract; the log names the source of each figure). v1/v2 set CMD_ICL_OVERRIDE, which is the USB 2.0 100/500 mA override: the docked 10-11 boot ran at exactly 500 mA (blackbox ICL_STATUS 0x1107 = AICL 0x1108 = 0x0a) while logging 2000 mA, the full battery discharged 50-200 mA on the dock, and the RP5 died overnight on the powered Elecom hub (10-12 morning). Verify docked: blackbox iclmax=28 within seconds of the plug and battery current >= 0.   # 18 (2026-10-11, UNTESTED): config MODVERSIONS=y + MODULE_ALLOW_BTF_MISMATCH=y. The 05:12 bare /flash/KERNEL swap (same source/config, one built-in driver patched) made the kernel refuse every module whose BTF no longer matched vmlinux ("failed to validate module [ath11k] BTF: -22": no wifi, bluetooth, zram, DP alt mode, audio macros; 90 s device timeouts on the splash; every boot) - vermagic alone checks nothing. Per-symbol CRCs are now the ABI check (a same-ABI rebuild loads, a real change is refused per symbol) and a stale module BTF is tolerated. Otherwise = 17.   # 17 (2026-10-11, UNTESTED): 0722 v2 - the charger looks the Type-C port manager's supply (tcpm-source-psy) up on every evaluation instead of caching an unreferenced pointer to it (same behaviour, no stale pointer if tcpm ever unbinds). NOT shipped: the usb_1 /delete-property/ wakeup-source dts change from 7c6613e (reverted before any build: the bsp-common sleep.d 010-usb-host hook makes the attached-device case a device-mode suspend = full core exit/reinit anyway, and dropping wakeup-source would have changed the UNDOCKED sleep path that works; the Odin's sm8550 usb_1 has no wakeup-source and still died 09-07, so the property is not the cure).   # 16 (2026-10-11): + 0722 (ours): pm8150b charger honours the USB-C/PD input budget (tcpm-source-psy contract or Rp, with ICL_OVERRIDE so USBIN_CURRENT_LIMIT_CFG counts); APSD rerun capped at 5, "Apsd not ready" to dbg; online reported as a boolean (killed the upowerd gboolean spam). Docked RP5 drew 500 mA and DISCHARGED the battery at ~240 mA at Steam home (measured 2026-10-11, blackbox + regmap); with 0722 the 5 V/2 A dock contract is used.   # 15 (2026-10-09): + 0721 (ours): msm_dp_audio_prepare returns 0 instead of -EINVAL while the DP link is down, so PipeWire ACP can probe a UCM DisplayPort device on an undocked boot without dropping the HiFi profile (the bsp 27 no-sound regression). Dock-audio candidate K; pairs with bsp-sm8250 29 (conditional UCM device + re-probe watcher).   # 14 (2026-10-08): 0720 REMOVED (parked in patches-staged/dp-audio: none of three variants made the DP port's first start play; the plain driver behaves the same for the second stream). Kernel = pkgrel 10 + nothing.   # 13 (2026-10-07): 0720 settles 1 s before the STOP/START cycle, retries once on EALREADY.   # 12 (2026-10-07): 0720 now STOPs and re-STARTs the port on a DEVICE_START timeout (accepting EALREADY left the stream silent).   # 11 (2026-10-07): + 0720 q6afe DEVICE_START retry + EALREADY = ok (DisplayPort AFE port 0x6020 timed out on its first start after idle: silent first stream, port stuck after repeats).   # 10 (2026-10-05): + 0619 msm submitqueue priority (Armada PR #574). kprobes on the RP5 showed the inversion live: the game's Turnip queue (uprio 2) ran at scheduler priority 0 (top) and gamescope's high-priority queue (uprio 0) at 2 (bottom), so the compositor missed refreshes under game load (18-25 % of frames on screen for 3 refresh periods).   # 9 (2026-10-02, TEST): Armada/ROCKNIX parity: 9998-gpu-tuning (ACD + gfx-mem bandwidth votes + TURBO voltages) REPLACES our old 9998-gpu-opp-table; 0702/0703/0704 parked in patches-staged (0704 never ran)   # 8 (2026-10-02, TEST): + 0703 SM8250 GPU SMMU ACTLR 0x32b + A650 GMU_CX_GMU_WFI_CONFIG=2 (downstream parity)   # 7 (2026-10-01, TEST): + 0702 (no-op: reset value is already 1) A650 leaves RBBM_NC_MODE_CNTL at reset (KGSL parity) — RP5 UBWC freeze test   # 5: (an earlier pkgrel 6 was never shipped: it backed 0700/0701 out on a misread of the STATIC Android DT; KGSL at runtime reports HIGHEST_BANK_BIT=15 on this LPDDR4X RP5 -> 15 is right, pkgrel 5 stands)  # 6 (2026-10-01, withdrawn): 0700/0701 (HBB 15) BACKED OUT to patches-staged: the RP5's live Android DT (LPDDR4X, ddr_device_type 7) still runs qcom,highest-bank-bit = 16, and 15 did not stop the DXVK freeze either. Keeps the 0007/0008 upstream backports (no SMEM HBB here -> 16)   # 5 (2026-10-01): + 0701 — A650 takes HBB from the shared UBWC config (7.1.2 forced 16 on the GPU while the DPU followed 0700 = 15 on LPDDR4X: "Inconclusive highest_bank_bit 16 (GPU) vs 15")   # 4 (2026-10-01): UBWC highest-bank-bit from SMEM — backports 1d234eeafc + 1b445022d1 (v7.3-rc1, smem adapted to 7.1.2) + our 0700 (HBB 15 when SMEM reports LPDDR4/4X and carries no HBB): RP5 DXVK whole-SoC freeze (UBWC surfaces laid out for the wrong bank bit)   # 3 (2026-09-28): qcom-abl boot contract — board dtbs only (Visionox variants added), mkbootimg + pocknix-build-bootimg hook, FW_LOADER_COMPRESS; 2: 0018 home-pulse stretch
pkgdesc="SM8250 kernel (stock ${pkgver} + ROCKNIX patch stack, board dtbs: Retroid Pocket 5/Flip 2/Mini/Mini V2 incl. Visionox) — packaged from 'make kernel' output"
# dtbs shipped to /boot/dtbs = the dtbs appended to /flash/KERNEL by pocknix-build-bootimg.
# Keep in sync with BOOTIMG_DTB_GLOBS (scripts/build-kernel.sh) and DTB_GLOBS (pocknix-build-bootimg).
_dtb_globs=('sm8250-retroidpocket-*.dtb')
arch=('aarch64')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-only')
# We own the kernel on this device; drop ALARM's generic one (pre-installed in
# the base tarball). No 'linux-pocknix' provides/replaces: that migration name
# belongs to the sm8550 lineage.
provides=("linux=${pkgver}")
conflicts=('linux-aarch64')
replaces=('linux-aarch64')
install=linux-pocknix.install
# python3 + cpio run the on-device /flash/KERNEL rebuild hook.
depends=('python' 'cpio')
options=('!strip')          # don't strip the kernel Image / DTBs (modules are already stripped by modules_install)
source=('pocknix-build-bootimg' '90-linux-pocknix.hook')
sha256sums=('SKIP' 'SKIP')

package() {
  local out="${startdir}/staged"     # = build/kernel/out, copied in by scripts/build-packages.sh
  if [ ! -f "${out}/Image" ] || [ ! -f "${out}/kernelrelease" ]; then
    echo "${pkgname}: no staged kernel at ${out}." >&2
    echo "  Run 'make kernel DEVICE=sm8250' first (it produces build/kernel/out), then rebuild this package." >&2
    return 1
  fi
  local kver; kver="$(cat "${out}/kernelrelease")"

  # kernel image + device trees
  install -Dm644 "${out}/Image" "${pkgdir}/boot/Image"
  install -d "${pkgdir}/boot/dtbs"
  local g d n=0
  for g in "${_dtb_globs[@]}"; do
    for d in "${out}/dtbs/"${g}; do
      [ -f "${d}" ] || continue
      install -m644 "${d}" "${pkgdir}/boot/dtbs/"; n=$((n+1))
    done
  done
  [ "${n}" -gt 0 ] || { echo "${pkgname}: no dtb in ${out}/dtbs matches ${_dtb_globs[*]}" >&2; return 1; }
  echo "${pkgname}: shipping ${n} dtb(s): $(ls "${pkgdir}/boot/dtbs")"

  # modules (already depmod'd by modules_install during `make kernel`; the .install re-runs depmod
  # post-transaction so modules.dep is correct against the live /usr/lib/modules path).
  install -d "${pkgdir}/usr/lib/modules"
  cp -a "${out}/modroot/lib/modules/${kver}" "${pkgdir}/usr/lib/modules/${kver}"

  # record the kver so the install scriptlet (and the /flash refresh hook) know the modules dir.
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/pocknix/kernelrelease" <<<"${kver}"

  # On-device /flash refresh: raw Image + dtbs copy (arm-efi, no bootimg) + the
  # alpm hook that runs it after a kernel pacman txn.
  [ -d "${out}/mkbootimg" ] || { echo "${pkgname}: ${out}/mkbootimg missing — re-run 'make kernel'"; return 1; }
  cp -r "${out}/mkbootimg" "${pkgdir}/usr/lib/pocknix/mkbootimg"
  install -Dm755 "${srcdir}/pocknix-build-bootimg" "${pkgdir}/usr/bin/pocknix-build-bootimg"
  install -Dm644 "${srcdir}/90-linux-pocknix.hook"  "${pkgdir}/usr/share/libalpm/hooks/90-linux-pocknix.hook"
}
