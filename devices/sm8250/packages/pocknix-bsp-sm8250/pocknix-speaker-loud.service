[Unit]
Description=pocknix: speaker loudness filter "Speakers (Loud)", owned by the sound card (sm8250)
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
# a WirePlumber restart (or crash + Restart=on-failure) re-creates the card with a new object id:
# stop with it (BindsTo) and get pulled back by it (wireplumber.service.wants symlink in the PKGBUILD)
BindsTo=wireplumber.service
PartOf=wireplumber.service

[Service]
Type=simple
ExecStart=/usr/lib/pocknix/pocknix-speaker-loud
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
