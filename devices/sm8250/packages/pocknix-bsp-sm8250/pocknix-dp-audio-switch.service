[Unit]
Description=Pocknix: dock audio profile (HDMI while card0-DP-1 is connected, HiFi otherwise)
After=wireplumber.service pipewire.service
Requires=wireplumber.service
PartOf=wireplumber.service

[Service]
Type=simple
ExecStart=/usr/lib/pocknix/pocknix-dp-audio-switch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
