# pocknix (RP5): loudness-maximized virtual sink in front of the speaker sink.
# The RP5's speaker hardware chain is already at its clean-gain ceiling
# (+40dB digital, +18dB PA, 8.5V boost rail) and is still quiet — the same
# drivers get their Android loudness from aggressive DSP compression, so we
# do the equivalent: +9dB makeup gain into a fast lookahead limiter
# (swh-plugins LADSPA), which raises perceived loudness without hard
# clipping. Apps play into "Speakers (Loud)"; it feeds the real UCM speaker
# sink. Headphones keep the direct (uncompressed) path.
#
# 2026-10-05 (bsp 21), measured with a USB mic on the RP5:
#  * makeup +12 dB (was +9): with the WSA compander off (it pumped 4-8 dB, see pocknix-speaker-volume)
#    the speakers lost ~14 dB at low level; +12 puts a typical game mix (peaks around -12 dBFS) at the
#    ceiling without the limiter acting. Hotter mixes are limited: a -6 dBFS burst ducks a quiet tone
#    ~6 dB for the burst's length. That is the loudness/dynamics trade on speakers this small.
#  * lawL/lawR: a plain gain stage after the limiter. pocknix-speaker-volume drives its "Mult" so that
#    slider % maps to the same number of dB per step (PipeWire's own cubic law is -36 dB at 25 %).
#    Left at 1.0 (daemon not running) the chain behaves as before with the cubic slider.
#
# 2026-10-10 (bsp 31): this is a TEMPLATE. It no longer lives in pipewire.conf.d: pocknix-speaker-loud
# (user service, after WirePlumber) renders it with the sound card's live PipeWire object id into
# @DEVICE_ID@ and runs it as its own `pipewire -c` process. Steam's client enumerates audio devices
# through libpipewire and lists a sink separately unless its device.id names a real Device object
# (verified 2026-10-10: a test sink with the card's id was folded under "Built-in Audio", one without
# was listed; a bogus id is listed too). With it the filter stays a plain Audio/Sink (pipewire-pulse
# needs that, see below) and Steam's device list has only "Built-in Audio" again (bsp 25..30 showed
# "Speakers (Loud)" / pocknix_speaker_loud as a second device and Steam's first-run picker came up).
# The id is only known once WirePlumber has created the card, which is why a static fragment cannot do it.
# This file must stay a complete `pipewire -c` config (spa-libs + the four modules below).
context.properties = { log.level = 2 }
context.spa-libs = {
  audio.convert.* = audioconvert/libspa-audioconvert
  support.*       = support/libspa-support
}
context.modules = [
  { name = libpipewire-module-rt args = { nice.level = -11 } flags = [ ifexists nofail ] }
  { name = libpipewire-module-protocol-native }
  { name = libpipewire-module-client-node }
  { name = libpipewire-module-adapter }
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "Speakers (Loud)"
      media.name       = "Speakers (Loud)"
      filter.graph = {
        nodes = [
          { type = ladspa name = limiter plugin = fast_lookahead_limiter_1913 label = fastLookaheadLimiter
            control = { "Input gain (dB)" = 12.0 "Limit (dB)" = -0.5 "Release time (s)" = 0.15 } }
          { type = builtin name = lawL label = linear control = { "Mult" = 1.0 "Add" = 0.0 } }
          { type = builtin name = lawR label = linear control = { "Mult" = 1.0 "Add" = 0.0 } }
        ]
        links = [
          { output = "limiter:Output 1" input = "lawL:In" }
          { output = "limiter:Output 2" input = "lawR:In" }
        ]
        inputs  = [ "limiter:Input 1" "limiter:Input 2" ]
        outputs = [ "lawL:Out" "lawR:Out" ]
      }
      capture.props = {
        node.name    = "pocknix_speaker_loud"
        # MUST stay exactly Audio/Sink. pipewire-pulse answers a client's stream-create
        # request only once it finds the stream's peer, and its peer test is
        # media.class == "Audio/Sink" (or "Audio/Duplex") — module-protocol-pulse
        # collect.c find_peer_for_link. The smart-filter rule moves every Speaker
        # stream onto this filter, so with Audio/Sink/Internal (bsp 25..29) no
        # Pulse client ever got its reply: Steam UI sounds, Chromium and most games
        # were silent with the node "running" and an xrun every cycle (2026-10-10,
        # fresh 20261008 card). The filter therefore shows in device lists as
        # "Speakers (Loud)"; hiding it is device.id (bsp 31), not the class.
        media.class  = Audio/Sink
        # Rendered by pocknix-speaker-loud: `device.id = <id of alsa_card.platform-sound>`, or an
        # empty line if the card never appeared (filter still works, just visible to Steam).
        @DEVICE_ID@
        audio.position = [ FL FR ]
        filter.smart = true
        filter.smart.target = { node.name = "alsa_output.platform-sound.HiFi__Speaker__sink" }
      }
      playback.props = {
        node.name    = "pocknix_speaker_loud_out"
        node.passive = true
        audio.position = [ FL FR ]
        stream.dont-remix = true
      }
    }
  }
]
