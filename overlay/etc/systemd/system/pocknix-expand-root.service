[Unit]
Description=Expand root partition + filesystem to fill the disk (first boot, before any other writer, then reboot)
# 2026-10-10: this used to float in multi-user.target, so on the first boot the ext4 online resize
# ran WHILE Steam was already downloading. On the RP5 that left the block bitmaps wrong and Steam's
# new files landed on pages of bash, libstdc++ etc. (HANDOFF 2026-10-09 15:00; E1 proved the same
# card is byte-clean when the resize happens with nothing else writing). Now it runs right after
# the kernel's root remount, ahead of every sysinit unit that writes to the root, then syncs and
# reboots; the second boot sees the grown filesystem cold from disk.
DefaultDependencies=no
After=systemd-remount-fs.service local-fs.target
Before=sysinit.target shutdown.target
Before=systemd-journal-flush.service systemd-tmpfiles-setup.service systemd-random-seed.service
Before=systemd-sysusers.service systemd-update-done.service systemd-machine-id-commit.service
Before=systemd-hwdb-update.service systemd-journal-catalog-update.service ldconfig.service
Before=systemd-firstboot.service systemd-update-utmp.service systemd-repart.service
Before=plymouth-read-write.service systemd-binfmt.service
Conflicts=shutdown.target
ConditionPathExists=!/var/lib/pocknix/expand-root.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/pocknix-expand-root

[Install]
WantedBy=sysinit.target
