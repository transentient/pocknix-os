#!/bin/sh
# pocknix-cutscene-wait — ExecStartPre for plymouth-quit.service (drop-in
# /etc/systemd/system/plymouth-quit.service.d/10-holodor-cutscene.conf).
#
# Holds the boot splash's quit until the Holodor cutscene has played: the theme
# preloads its 34 frames (~1 s) then plays them at 10 fps (3.4 s), and the splash
# appears ~0.1 s after plymouthd starts. Waiting until plymouthd has been up
# POCKNIX_CUTSCENE_SECS (default 7) covers that with margin for a slow preload.
# plymouth-quit-wait then blocks until plymouthd is really gone, and getty@tty1 is
# ordered after plymouth-quit-wait, so the deck session (and gamescope's DRM master
# grab) always starts after the splash has released the panel.
#
# This must be root's plymouth-quit: plymouthd ignores commands from non-root
# clients, so a `plymouth quit` from the deck session never worked (2026-09-23:
# plymouthd stayed alive holding DRM master; gamescope ran blind, Steam audible).
need="${POCKNIX_CUTSCENE_SECS:-7}"
pid="$(pidof plymouthd 2>/dev/null | awk '{print $1}')"
[ -n "$pid" ] || exit 0
up="$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')"
[ -n "$up" ] || exit 0
[ "$up" -lt "$need" ] 2>/dev/null && sleep $(( need - up ))
exit 0
