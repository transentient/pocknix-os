#!/bin/bash
# pocknix-expand-root — on the first boot, grow the root partition to fill the whole card, then
# grow the ext4 filesystem online, then REBOOT. The SD image is built as rootfs + SD_SLACK_MIB
# (a few GB), so flashed to a bigger card it leaves the rest unallocated; without this the root
# fills up fast (e.g. mid-Steam-download). Runs once (guarded by a flag).
#
# It runs from sysinit, ordered before every unit that writes to the root (see the .service), so
# the online resize is the ONLY writer. Then: sync, stamp, ask for a full fsck on the next boot,
# reboot. The resize must never race another writer again (RP5 Lexar corruption, 2026-10-09).
set -euo pipefail

FLAG=/var/lib/pocknix/expand-root.done
LOGF=/var/lib/pocknix/expand-root.log
[ -e "${FLAG}" ] && exit 0

# Our stdout goes to the journal, which is still in /run this early and is NOT flushed to disk
# by the reboot below — so keep our own log on the root too.
log() { echo "[pocknix-expand-root] $*"; mkdir -p "$(dirname "${LOGF}")"; echo "$(date -u +%FT%TZ) $*" >> "${LOGF}" 2>/dev/null || true; }
# The unit is ConditionPathExists=!${FLAG}: once stamped it is not even started (0 ms on
# every later boot). An internal install inherits the stamp through the installer's rsync
# of the running root (pocknix-install-internal sizes the internal root itself), so it
# never runs there. EVERY exit below must stamp, or the probe repeats each boot (B4).
stamp() { mkdir -p "$(dirname "${FLAG}")"; { date -u +%FT%TZ; echo "$*"; } > "${FLAG}"; sync; }
splash() { timeout 3 plymouth display-message --text="$1" >/dev/null 2>&1 || true; }

# Resolve the real device backing / (e.g. /dev/mmcblk0p2, /dev/sda2, /dev/nvme0n1p2).
src=$(findmnt -nro SOURCE /)
src=$(readlink -f "${src}")
case "${src}" in
  */*[0-9]p[0-9]*) disk="${src%p*}"; part="${src##*p}" ;;   # mmcblk0p2 / nvme0n1p2
  *[0-9])          disk="${src%%[0-9]*}"; part="${src##*[!0-9]}" ;;  # sda2
  *) log "cannot parse root device '${src}' — nothing to expand; stamping so this is not retried every boot"; stamp "no-parse ${src}"; exit 0 ;;
esac

log "root=${src} disk=${disk} part=${part} (first boot: resizing alone, then rebooting)"
splash "First boot: expanding storage, the device will restart once..."

# growpart relocates the GPT backup header to the end of the (now larger) disk and extends the
# last partition into the free space. Exit 2 = NOCHANGE (already full): nothing to do, no reboot.
rc=0
growpart "${disk}" "${part}" >> "${LOGF}" 2>&1 || rc=$?
if [ "${rc}" -eq 2 ]; then
  log "partition already fills the disk — nothing to expand"
  resize2fs "${src}" >> "${LOGF}" 2>&1 || true   # fs may still be smaller than the partition (pre-grown card)
  stamp "nochange"
  exit 0
fi
[ "${rc}" -eq 0 ] || log "growpart failed (rc=${rc}) — leaving partition as-is, still trying resize2fs"

# Online-grow the ext4 root to the (possibly) larger partition. This is the one write in flight.
resize2fs "${src}" >> "${LOGF}" 2>&1 || log "resize2fs returned non-zero (already at max?)"
sync; sync

stamp "resized ${src} on $(date -u +%FT%TZ), rebooting"
# (No fsck on the next boot: the kernel cmdline mounts root rw, so systemd-fsck-root never runs;
# a /forcefsck here would be inert. Verify a card offline on fusor: e2fsck -fn.)
log "done — root filesystem expanded to fill the disk; rebooting so the grown filesystem is read cold"
splash "Storage expanded, restarting..."
systemctl --no-block reboot
exit 0
